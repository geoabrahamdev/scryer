{
  "name": "scryer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Browser-only Palantir Foundry-style FDE demo. Paste a messy document, watch an ontology assemble into a live knowledge graph, query in natural language.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "cmdk": "^1.0.4",
    "cytoscape": "^3.30.4",
    "cytoscape-fcose": "^2.2.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shiki": "^1.24.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cytoscape": "^3.21.8",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
